# Zixploy Production Environment Variables
# Phase 8 M6 — docs/runbooks/release-checklist.md
#
# Usage:
#   cp deploy/control-plane/.env.production.example deploy/control-plane/.env
#   # Edit all required values, then:
#   docker compose -f deploy/control-plane/docker-compose.prod.yml --env-file deploy/control-plane/.env up -d
#
# ⚠️  NEVER commit .env to git — only .env.production.example

# =============================================================================
# REQUIRED — ต้องตั้งค่าทุกข้อก่อน start production
# =============================================================================

# Domain name ที่ DNS ชี้มาที่ server นี้แล้ว (ไม่มี https:// นำหน้า)
ZIXPLOY_DOMAIN=zixploy.example.com

# Email สำหรับ Let's Encrypt ACME — รับ notification เมื่อ cert ใกล้หมดอายุ
ACME_EMAIL=admin@example.com

# Image version tag (ใช้ immutable digest ใน production จริง)
# ตัวอย่าง: ZIXPLOY_VERSION=0.1.0
ZIXPLOY_VERSION=0.1.0

# =============================================================================
# REQUIRED — สร้างก่อน deploy
# =============================================================================
# Master encryption key — สร้างด้วย:
#   openssl rand -base64 32 > /etc/zixploy/master.key
#   chmod 600 /etc/zixploy/master.key
#   chown root:root /etc/zixploy/master.key
#
# path นี้ bind-mount เข้า container เป็น /run/secrets/master_key
# ห้ามใส่ค่า key โดยตรงในไฟล์ .env — ใช้ path เท่านั้น
MASTER_KEY_PATH=/etc/zixploy/master.key

# =============================================================================
# OPTIONAL — มี default ที่ใช้งานได้แต่ควรตรวจสอบ
# =============================================================================

# Log level: debug | info | warn | error (default: info)
ZIXPLOY_LOG_LEVEL=info

# Backup retention: จำนวนไฟล์ backup ล่าสุดที่เก็บไว้ต่อ directory (default: 14)
ZIXPLOY_BACKUP_RETENTION=14
