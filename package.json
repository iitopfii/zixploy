{
  "name": "zixploy",
  "private": true,
  "version": "0.0.1",
  "description": "Lightweight single-node deployment platform (Nuxt + Elysia/Bun + SQLite + Traefik)",
  "workspaces": [
    "apps/*",
    "internal/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run --filter @zixploy/control-api dev",
    "dev:worker": "bun run --filter @zixploy/deploy-worker dev",
    "dev:dashboard": "bun run --filter @zixploy/dashboard dev",
    "dev:proxy": "docker compose -f deploy/control-plane/docker-compose.dev.yml up -d",
    "dev:proxy:down": "docker compose -f deploy/control-plane/docker-compose.dev.yml down",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "migrate:check": "bun run internal/db/scripts/migration-check.ts",
    "bootstrap:admin": "bun run apps/control-api/src/cli/bootstrap-admin.ts",
    "backup": "bun run internal/db/scripts/backup.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
