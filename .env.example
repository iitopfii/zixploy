# ============================================================
# Zixploy — Local Development Environment Variables
# ============================================================
# Copy as .env and fill in real values. NEVER commit .env to git.

# --- Database ---
# Default: /var/lib/zixploy/control.db (ใช้ได้บน Linux)
# Local dev: ปล่อยว่างไว้หรือระบุ path แบบ absolute
# ZIXPLOY_DB_PATH=/var/lib/zixploy/control.db

# --- API ---
# Port ที่ Control API listen (bind เฉพาะ 127.0.0.1 เสมอ)
# ZIXPLOY_API_PORT=3001

# --- Logging ---
# debug | info | warn | error (default: info ใน production, error ใน test)
# ZIXPLOY_LOG_LEVEL=info

# ============================================================
# GitHub App Integration (Phase 2)
# ตั้งค่าทั้งหมดเพื่อเปิดใช้ GitHub integration
# ถ้าไม่ตั้งค่า Phase 1 (login + project CRUD) ยังทำงานได้
# ============================================================

# GitHub App ID (ดูได้จาก GitHub App settings หน้า General)
# ZIXPLOY_GITHUB_APP_ID=123456

# GitHub App Slug (ชื่อใน URL: github.com/apps/<slug>)
# ZIXPLOY_GITHUB_APP_SLUG=my-zixploy-app

# Path ไปยัง private key PEM file (GitHub App → Generate a private key)
# ห้าม hardcode key ใน env variable โดยตรง — ใช้ไฟล์เท่านั้น
# ZIXPLOY_GITHUB_APP_PRIVATE_KEY_FILE=/etc/zixploy/github-app.pem

# Webhook secret — ตั้งใน GitHub App → Webhook → Secret
# ZIXPLOY_GITHUB_WEBHOOK_SECRET=<random-string-ยาวอย่างน้อย-32-chars>

# Callback/Setup URL — GitHub จะ redirect มาที่นี่หลัง install
# Development: ใช้ ngrok หรือ tunnel เพื่อรับ webhook
# ZIXPLOY_GITHUB_CALLBACK_URL=https://your-host.example.com/api/v1/github/callback

# ============================================================
# GitHub App Registration Guide
# ============================================================
# 1. ไปที่ https://github.com/settings/apps/new (Personal)
#    หรือ https://github.com/organizations/<org>/settings/apps/new (Org)
#
# 2. ตั้งค่า:
#    - GitHub App name: ชื่อที่ต้องการ (เช่น "My Zixploy")
#    - Homepage URL: URL ของ dashboard ของคุณ
#    - Setup URL: https://your-host/api/v1/github/callback
#    - Webhook URL: https://your-host/api/v1/github/webhooks
#    - Webhook secret: random string ยาวอย่างน้อย 32 chars
#
# 3. Permissions (Repository):
#    - Contents: Read-only
#    - Metadata: Read-only (บังคับ)
#
# 4. Subscribe to events:
#    - Push
#    - Installation
#    - Installation repositories
#
# 5. Where can this GitHub App be installed?
#    - Only on this account (สำหรับ personal use)
#    - Any account (สำหรับ multi-org)
#
# 6. หลังสร้าง:
#    - Copy App ID → ZIXPLOY_GITHUB_APP_ID
#    - Copy Client ID → (ไม่ต้องใช้ใน Phase 2)
#    - Generate a private key → บันทึกเป็นไฟล์ → ZIXPLOY_GITHUB_APP_PRIVATE_KEY_FILE
#    - ตั้ง Webhook secret → ZIXPLOY_GITHUB_WEBHOOK_SECRET

# ============================================================
# Development Webhook Testing
# ============================================================
# ใช้ ngrok หรือ smee.io เพื่อ forward GitHub webhooks มาที่ localhost:
#
# ngrok:
#   ngrok http 3001
#   -> เอา URL ไปตั้งเป็น Webhook URL และ Setup URL ใน GitHub App
#
# smee.io:
#   smee --url https://smee.io/<channel-id> --target http://localhost:3001/api/v1/github/webhooks
#
# ข้อควรระวัง:
# - อย่าใช้ tunnel URL เดิมกับ production
# - ปิด tunnel เมื่อ dev เสร็จ
