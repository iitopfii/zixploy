# ============================================================
# Zixploy — Local Development Environment Variables
# ============================================================
# Copy as .env and fill in real values. NEVER commit .env to git.

# --- Database ---
# Default: /var/lib/zixploy/control.db (ใช้ได้บน Linux)
# Local dev: ปล่อยว่างไว้หรือระบุ path แบบ absolute
# ZIXPLOY_DB_PATH=/var/lib/zixploy/control.db

# --- API ---
# Port ที่ Control API listen (bind เฉพาะ 127.0.0.1 เสมอ)
# ZIXPLOY_API_PORT=3001

# --- Logging ---
# debug | info | warn | error (default: info ใน production, error ใน test)
# ZIXPLOY_LOG_LEVEL=info

# ============================================================
# Master Key (Phase 2) — จำเป็นสำหรับ GitHub App integration
# ============================================================
# GitHub App credentials (private key, webhook secret, client secret)
# เก็บใน DB แบบเข้ารหัส AES-256-GCM — master key อยู่นอก DB เท่านั้น
# ไม่ตั้งค่า → สร้าง GitHub App ไม่ได้ แต่ Phase 1 (login + project CRUD) ยังทำงาน
#
# สร้าง key:
#   openssl rand -base64 32 > /etc/zixploy/master.key
#   chmod 600 /etc/zixploy/master.key
#
# ZIXPLOY_MASTER_KEY_FILE=/etc/zixploy/master.key
#
# รองรับ key rotation ด้วย JSON format (ดู docs/encryption.md):
#   { "active": 2, "keys": { "1": "<base64>", "2": "<base64>" } }
#
# ⚠️ Backup master key แยกช่องทางจาก DB backup — เก็บรวมกันทำให้ encryption ไร้ความหมาย

# ============================================================
# Public Base URL (Phase 2)
# ============================================================
# URL ที่ GitHub เข้าถึงได้ — ใช้สร้าง webhook URL และ setup URL ใน App manifest
# Development: ใช้ ngrok/smee tunnel (ดูด้านล่าง)
# ZIXPLOY_BASE_URL=https://your-host.example.com

# ============================================================
# GitHub App Setup (Phase 2)
# ============================================================
# ไม่ต้องตั้งค่า env var สำหรับ GitHub App — สร้างผ่าน UI ได้เลย
#
# ขั้นตอน:
# 1. ตั้ง ZIXPLOY_MASTER_KEY_FILE และ ZIXPLOY_BASE_URL แล้ว restart Control API
# 2. เปิด Dashboard → GitHub Apps → "สร้าง GitHub App"
# 3. กรอกชื่อ app (ไม่เกิน 34 ตัวอักษร) + organization (ถ้าต้องการ)
# 4. ระบบจะพาไป GitHub เพื่อยืนยัน — กด "Create GitHub App"
# 5. GitHub ส่ง credentials กลับมาอัตโนมัติ (App ID, private key, webhook secret,
#    client ID/secret) → ระบบเข้ารหัสแล้วเก็บลง DB ไม่ต้องคัดลอกเอง
# 6. กด "Install" → เลือก account และ repositories → เสร็จ
#
# App ที่สร้างจะได้ permissions ขั้นต่ำอัตโนมัติ:
#   - Contents: Read-only
#   - Metadata: Read-only
#   - Events: push (installation/installation_repositories ได้อัตโนมัติ)
#
# แต่ละ App มี webhook endpoint ของตัวเอง: /api/v1/github/webhooks/<app-id>
# พร้อม webhook secret เฉพาะตัวที่ GitHub generate ให้

# ============================================================
# Development Webhook Testing
# ============================================================
# GitHub ต้องเข้าถึง base URL ได้จริงเพื่อส่ง webhook และทำ manifest flow
#
# ngrok:
#   ngrok http 3001
#   -> เอา URL ไปตั้งเป็น ZIXPLOY_BASE_URL แล้ว restart API
#
# smee.io (forward webhook อย่างเดียว ใช้กับ manifest flow ไม่ได้):
#   smee --url https://smee.io/<channel-id> --target http://localhost:3001/api/v1/github/webhooks/<app-id>
#
# ข้อควรระวัง:
# - อย่าใช้ tunnel URL เดิมกับ production
# - App ที่สร้างด้วย tunnel URL จะมี webhook URL ที่ตายเมื่อปิด tunnel — ลบแล้วสร้างใหม่
# - ปิด tunnel เมื่อ dev เสร็จ
